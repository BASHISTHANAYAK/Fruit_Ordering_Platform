# Server Configuration
PORT=5000

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/vegefoods?retryWrites=true&w=majority
MONGOODB_URL=

# JWT Secrets for Authentication
ADMIN_JWT_SECRET_KEY=your_admin_jwt_secret_key_here
USER_JWT_SECRET_KEY=your_user_jwt_secret_key_here

# Nodemailer Configuration (Gmail / SMTP)
# EMAIL_USER: Your Gmail address (e.g., yourname@gmail.com)
# EMAIL_PASS: 16-character Gmail App Password (generated via Google Account > Security > App Passwords)
EMAIL_USER=
EMAIL_PASS=
